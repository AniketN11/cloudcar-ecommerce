pipeline {

    agent any

    stages {

        stage('Clone Code') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/AniketN11/cloudcar-ecommerce.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t cloudcart-ecommerce .'
            }
        }

        stage('Deploy Container') {
            steps {
                sh 'docker rm -f cloudcart || true'
                sh 'docker run -d --name cloudcart -p 8081:80 cloudcart-ecommerc '
            }
        }
    }
}
